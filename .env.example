# ─── Telegram ────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# ─── Web App ─────────────────────────────────────
WEBAPP_URL=https://your-webapp-domain.com
ADMIN_IDS=123456789  # Comma-separated Telegram user IDs for /test_digest

# ─── AI Providers ────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── PostgreSQL ──────────────────────────────────
POSTGRES_USER=daylog_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=daylog
METABASE_RO_PASSWORD=CHANGE_ME_TO_STRONG_RO_PASSWORD  # <--- Добавили это
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ─── App Config ──────────────────────────────────
DB_ECHO=False
LOG_LEVEL=INFO

# Аналитика и мониторинг
SENTRY_DSN=https://your-dsn-key@sentry.io/project-id
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com