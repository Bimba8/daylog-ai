# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# FIX: CQ-06 — PostgreSQL вместо SQLite (async через asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/daylog

# Redis URL для FSM-хранилища aiogram и APScheduler jobstore
# db=0 используется для FSM, db=1 — для persistent scheduler jobs
REDIS_URL=redis://localhost:6379/0

# Выводить SQL-запросы в консоль (True для отладки, False для продакшена)
DB_ECHO=False
